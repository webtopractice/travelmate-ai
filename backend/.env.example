# Environment variables for the AI Travel Assistant backend.
# Copy this file to .env and fill in your keys.

# --- Required ---
# Get your free key at: https://console.anthropic.com/
ANTHROPIC_API_KEY=your_anthropic_api_key_here

# --- Optional (free signup) ---
# Get your free key at: https://home.openweathermap.org/api_keys
OPENWEATHER_API_KEY=your_openweather_api_key_here

# --- Hotels & Activities ---
# No key needed — uses OpenStreetMap (Nominatim + Overpass API), both free
# and keyless. Nothing to configure here.
